# Supabase project settings (copy to .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Fana Cafe Telebirr merchant details shown to residents at checkout.
# These are display details, not API secrets.
TELEBIRR_MERCHANT_NAME=Fana Cafe
TELEBIRR_MERCHANT_ACCOUNT=

# Exact credited-party name shown on the official Telebirr receipt.
# Use comma-separated aliases only if the same merchant is shown under multiple names.
TELEBIRR_VERIFIED_RECIPIENT_NAMES=

# Optional exact credited account number from the official receipt.
# Leave blank if Telebirr masks the number on its public receipt.
TELEBIRR_VERIFIED_RECIPIENT_ACCOUNT=

# Development payment mode. Keep "mock" only for local testing.
PAYMENTS_MODE=mock

# Order and stock settings
DELIVERY_FEE_ETB=0
RESERVATION_HOLD_MINUTES=30
